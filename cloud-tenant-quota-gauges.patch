+.cloud-tenant-quota-gauges {
+  padding: 20px;
+  background: #fff;
+
+  .quota-gauges-header {
+    margin-bottom: 20px;
+    padding-bottom: 15px;
+    border-bottom: 2px solid #e7e7e7;
+
+    .quota-gauges-title {
+      font-size: 24px;
+      font-weight: 400;
+      color: #292e34;
+      margin: 0 0 5px 0;
+    }
+
+    .quota-gauges-subtitle {
+      font-size: 14px;
+      color: #72767b;
+      margin: 0;
+    }
+  }
+
+  .quota-gauges-loading,
+  .quota-gauges-error,
+  .quota-gauges-empty {
+    text-align: center;
+    padding: 40px 20px;
+    color: #72767b;
+
+    .quota-loading-spinner {
+      margin-bottom: 15px;
+    }
+
+    .pficon {
+      font-size: 48px;
+      color: #cc0000;
+      margin-bottom: 15px;
+    }
+
+    p {
+      font-size: 16px;
+      margin: 0;
+    }
+  }
+
+  .quota-gauges-grid {
+    display: grid;
+    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
+    gap: 20px;
+    margin-top: 20px;
+
+    @media (min-width: 768px) {
+      grid-template-columns: repeat(2, 1fr);
+    }
+
+    @media (min-width: 1200px) {
+      grid-template-columns: repeat(3, 1fr);
+    }
+
+    @media (min-width: 1600px) {
+      grid-template-columns: repeat(5, 1fr);
+    }
+  }
+}
+
