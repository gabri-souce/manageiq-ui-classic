+
+  .quota-gauge-footer {
+    text-align: center;
+    padding-top: 10px;
+    border-top: 1px solid #ededed;
+
+    .quota-available {
+      font-size: 13px;
+      font-weight: 500;
+      padding: 5px 10px;
+      border-radius: 3px;
+      display: inline-block;
+
+      &:not(.unlimited):not(.over-quota) {
+        color: #3f9c35;
+        background: #e4f5e2;
+      }
+
+      &.unlimited {
+        color: #0088ce;
+        background: #def3ff;
+      }
+
+      &.over-quota {
+        color: #cc0000;
+        background: #faeae8;
+      }
+    }
+  }
+
+  .quota-gauge-unavailable {
+    text-align: center;
+    padding: 40px 20px;
+    color: #72767b;
+
+    p {
+      font-size: 14px;
+      margin: 0;
+    }
+  }
+
+  // Status color indicators
+  &.quota-status-ok {
+    border-left: 4px solid #3f9c35;
+  }
+
+  &.quota-status-warning {
+    border-left: 4px solid #ec7a08;
+  }
+
+  &.quota-status-critical {
+    border-left: 4px solid #cc0000;
+  }
+}
+
+// Dark theme support (if needed)
+.theme-dark {
+  .cloud-tenant-quota-gauges {
+    background: #292e34;
+  }
+
+  .quota-gauge-card {
+    background: #393f44;
