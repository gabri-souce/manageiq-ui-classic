+      h3 {
+        color: #f0f0f0;
+      }
+    }
+
+    .quota-gauge-values {
+      background: #292e34;
+
+      .value-number {
+        color: #f0f0f0;
+      }
+    }
+
+    .quota-gauge-footer {
+      border-top-color: #4d5258;
+    }
+  }
+}
