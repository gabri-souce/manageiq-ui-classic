+    justify-content: space-between;
+    align-items: center;
+    margin-bottom: 15px;
+    padding-bottom: 10px;
+    border-bottom: 1px solid #ededed;
+
+    h3 {
+      font-size: 16px;
+      font-weight: 500;
+      color: #292e34;
+      margin: 0;
+    }
+
+    .quota-gauge-units {
+      font-size: 12px;
+      color: #72767b;
+      font-weight: 400;
+    }
+  }
+
+  .quota-gauge-values {
+    display: flex;
+    align-items: baseline;
+    justify-content: center;
+    margin-bottom: 15px;
+    padding: 10px;
+    background: #f5f5f5;
+    border-radius: 3px;
+
+    .quota-value-primary,
+    .quota-value-secondary {
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+
+      .value-label {
+        font-size: 11px;
+        color: #72767b;
+        text-transform: uppercase;
+        letter-spacing: 0.5px;
+        margin-bottom: 3px;
+      }
+
+      .value-number {
+        font-size: 24px;
+        font-weight: 300;
+        color: #292e34;
+      }
+    }
+
+    .quota-value-primary .value-number {
+      color: #0088ce;
+      font-weight: 500;
+    }
+
+    .quota-value-separator {
+      font-size: 20px;
